/files/646936"],"collection":["Human Reference Atlas"],"collectionid":["2"],"content":["$3"],"viewcount":["690"],"downloadcount":["333"],"_score":["5.390831"]},"highlights":{"description":"Uberon&#32;describes&#32;this&#32;FTU&#32;as&#32;follows&#58;&#32;&quot;The&#32;parenchymatous&#32;tissue&#32;of&#32;the&#32;spleen&#32;that&#32;surrounds&#32;splenic&#32;blood&#32;vessels&#44;&#32;consists&#32;of&#32;compact&#32;masses&#32;of&#32;lymphatic&#32;cells&#32;and&#32;is&#32;where&#32;foreign&#32;material&#32;removed&#32;from&#32;the&#32;blood&#32;is&#32;used&#32;to&#32;initiate&#32;an&#32;immune&#32;reaction&#32;that&#32;results&#32;in&#32;the&#32;production&#32;of&#32;<em>antibodies</em>&#46;&quot;","title":"White&#32;Pulp"}}]},"facets":{"keywords":{"buckets":[{"value":"Immunity","count":6},{"value":"antibody","count":4},{"value":"biology","count":4},{"value":"science","count":4},{"value":"Protein","count":3},{"value":"IgG","count":2},{"value":"immune","count":2},{"value":"immune system","count":2},{"value":"proteins","count":2},{"value":"Cells and Organelles","count":1}]},"license":{"buckets":[{"value":"Public Domain","count":6},{"value":"CC-BY","count":1}]},"category":{"buckets":[]}}}
