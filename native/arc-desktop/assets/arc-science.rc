// Windows resources for the desktop executable: the "as" tile icon and the
// version block Explorer and Task Manager display as "Arc Science".
1 ICON "arc-science.ico"

1 VERSIONINFO
FILEVERSION 0,6,0,0
PRODUCTVERSION 0,6,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Arc Science"
      VALUE "FileDescription", "Arc Science"
      VALUE "FileVersion", "0.6.0"
      VALUE "InternalName", "Arc Science"
      VALUE "OriginalFilename", "Arc Science.exe"
      VALUE "ProductName", "Arc Science"
      VALUE "ProductVersion", "0.6.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
