{
  "name": "arc-core",
  "version": "0.1.0",
  "description": "Shared Arc Kit MCP server, C2 unified console, and core tools for shelf search, claim recording, gate checks, toolpack loading and memory.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./ui/panel.js",
    "./ui/panel": "./ui/panel.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "ui",
    "locale",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/core.test.mjs test/ui-panel.test.mjs"
  },
  "arc": {
    "client": {
      "platform": "web",
      "inject": [
        "@arc-harness/arc-client-ui-slots",
        "@arc-harness/arc-client-locale",
        "@arc-harness/arc-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  }
}
