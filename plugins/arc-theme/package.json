{
  "name": "arc-theme",
  "version": "0.6.0",
  "description": "Three interface themes (Arc Harness paper, Black and white, Radium) with Geist type, menu backdrop blur, Settings copy map, choreographed startup intro and zero blue.",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale",
    "docs/policy.md"
  ],
  "scripts": {
    "test": "node test/theme.test.mjs"
  },
  "arc": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@arc-harness/arc-client-ui-theme",
        "@arc-harness/arc-client-ui-slots",
        "@arc-harness/arc-client-locale",
        "@arc-harness/arc-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@arc-harness/arc-client-locale": "^0.2.1-rc.2",
    "@arc-harness/arc-client-ui-settings": "^0.2.1-rc.2",
    "@arc-harness/arc-client-ui-slots": "^0.2.1-rc.2",
    "@arc-harness/arc-client-ui-theme": "^0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22.19",
    "arc": ">=0.2.1-rc.2 <0.3.0"
  }
}
