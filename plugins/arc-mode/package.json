{
  "name": "arc-mode",
  "version": "0.1.0",
  "description": "The Advanced page of Arc Harness: the mode switch, the list of what the mode contains, and the measured results.",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale",
    "docs/policy.md"
  ],
  "scripts": {
    "test": "node --test test/mode.test.mjs"
  },
  "arc": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@arc-harness/arc-client-ui-slots",
        "@arc-harness/arc-client-locale",
        "@arc-harness/arc-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@arc-harness/arc-client-locale": "^0.2.1-rc.2",
    "@arc-harness/arc-client-ui-settings": "^0.2.1-rc.2",
    "@arc-harness/arc-client-ui-slots": "^0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22.19",
    "arc": ">=0.2.1-rc.2 <0.3.0"
  }
}
