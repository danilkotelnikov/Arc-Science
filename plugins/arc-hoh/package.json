{
  "name": "arc-hoh",
  "version": "0.3.0",
  "description": "Harness^2 (Google) and Harness-of-Harness inside Arc Harness: an operating contract in every prompt, a hash-chained ledger, a deterministic accept gate, a Cammut brief and a Trace tab in the right sidebar.",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale",
    "docs/policy.md"
  ],
  "scripts": {
    "test": "node --test test/hoh.test.mjs"
  },
  "arc": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@arc-harness/arc-client-locale",
        "@arc-harness/arc-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@arc-harness/arc-tools": "^0.2.1-rc.2"
  },
  "engines": {
    "node": ">=22.19",
    "arc": ">=0.2.1-rc.2 <0.3.0"
  }
}
